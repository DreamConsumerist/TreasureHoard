{
  "name": "treasurehoard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "netlify dev",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "vite": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "netlify database migrations apply",
    "db:status": "netlify database status",
    "hash-password": "tsx scripts/hash-password.ts",
    "gen-secret": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64url'))\""
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@netlify/database": "^2.0.4",
    "@tanstack/react-query": "^5.108.4",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^1.0.0-beta.22",
    "hono": "^4.13.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@netlify/edge-functions": "^4.0.4",
    "@netlify/functions": "^6.1.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^1.0.0-beta.22",
    "netlify-cli": "^27.20.1",
    "oxlint": "^1.90.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24"
  }
}
