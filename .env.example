# Names of the environment variables this app needs. Real values are set in
# the Netlify UI (Project configuration → Environment variables) for all
# deploy contexts and local development; `netlify dev` pulls them down.
# Never put real values in this file.

# scrypt hash of the login password. Generate with: npm run hash-password
APP_PASSWORD_HASH=

# Random secret that signs session cookies. Generate with: npm run gen-secret
SESSION_SECRET=

# NETLIFY_DB_URL is provided by Netlify automatically. Do not set it.
